# .env.example — copy to .env and fill in. .env is git-ignored.
# Never commit real values, even test-mode ones.

# Postgres (docker-compose service name as host)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/billing

# Stripe TEST MODE keys only — never live keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: pin the Stripe Price ID for the Pro plan so POST /checkout does not
# list Products/Prices on every call. Leave blank to auto-discover/create.
STRIPE_PRO_PRICE_ID=

# App
ENV=local
LOG_LEVEL=info

# Background scheduler (nightly Stripe reconciliation). Set to false to disable.
ENABLE_SCHEDULER=true
